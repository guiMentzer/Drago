<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drago_hardware_interface</name>
  <version>0.1.0</version>
  <description>
    Hardware interface for the Drago robot arm. Provides the communication between ROS2 and Arduino. Offered by just a Guy
  </description>
  <maintainer email="guilhermepaivacrispim@gmail.com">Guy</maintainer>
  <license>TODO</license>

   <author email="guilhermepaivacrispim@gmail.com">Guy</author>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Export the plugin -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
